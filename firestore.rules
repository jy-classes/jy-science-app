rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function email() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn()
        && email() != null
        && exists(/databases/$(database)/documents/admins/$(email()))
        && get(/databases/$(database)/documents/admins/$(email())).data.active == true;
    }

    function teacherDoc() {
      return get(/databases/$(database)/documents/authorizedTeachers/$(email()));
    }

    function isTeacher() {
      return signedIn()
        && email() != null
        && exists(/databases/$(database)/documents/authorizedTeachers/$(email()))
        && teacherDoc().data.active == true;
    }

    function canManageClass(classKey) {
      return isAdmin()
        || (
          isTeacher()
          && classKey in teacherDoc().data.managedClasses
        );
    }

    function registeredStudent(studentUid) {
      return get(/databases/$(database)/documents/students/$(studentUid));
    }

    function currentSession(studentUid) {
      return get(/databases/$(database)/documents/studentSessions/$(studentUid));
    }

    match /admins/{adminEmail} {
      allow get: if signedIn() && email() == adminEmail;
      allow list, create, update, delete: if isAdmin();
    }

    match /authorizedTeachers/{teacherEmail} {
      allow get: if signedIn() && email() == teacherEmail;
      allow list, create, update, delete: if isAdmin();
    }

    match /students/{studentUid} {
      allow get: if signedIn();
      allow list: if isAdmin()
        || canManageClass(resource.data.classKey);
      allow create, update, delete: if isAdmin();
    }

    match /studentSessions/{studentUid} {
      allow create, update: if isAnonymous()
        && request.resource.data.studentUid == studentUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.birthDate == registeredStudent(studentUid).data.birthDate
        && request.resource.data.classLabel == registeredStudent(studentUid).data.classLabel
        && request.resource.data.studentNumber == registeredStudent(studentUid).data.studentNumber;

      allow read: if canManageClass(resource.data.classKey)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow delete: if isAdmin();
    }

    match /submissions/{studentUid} {
      allow create, update: if isAnonymous()
        && currentSession(studentUid).data.ownerUid == request.auth.uid
        && request.resource.data.studentUid == studentUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.classKey == currentSession(studentUid).data.classKey;

      allow read: if canManageClass(resource.data.classKey)
        || (
          signedIn()
          && currentSession(studentUid).data.ownerUid == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    match /evaluations/{studentUid} {
      allow read, create, update: if canManageClass(
        request.method == "create"
          ? request.resource.data.classKey
          : resource.data.classKey
      );
      allow delete: if isAdmin();
    }

    match /feedback/{studentUid} {
      allow read: if canManageClass(resource.data.classKey)
        || (
          signedIn()
          && currentSession(studentUid).data.ownerUid == request.auth.uid
        );

      allow create, update: if canManageClass(
        request.method == "create"
          ? request.resource.data.classKey
          : resource.data.classKey
      );

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
