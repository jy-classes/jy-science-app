rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "jobchemy@gmail.com"
        ];
    }

    match /submissions/{studentUid} {
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.studentUid == studentUid;

      allow read, update: if isTeacher()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow delete: if isTeacher();
    }

    match /evaluations/{studentUid} {
      allow read, write: if isTeacher();
    }

    match /feedback/{studentUid} {
      allow read: if isTeacher()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
